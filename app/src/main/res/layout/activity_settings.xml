<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#000000"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textColor="#FFFFFF" android:text="نوع الشادر" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/spinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp"/>
        <TextView android:textColor="#FFFFFF" android:text="الشفافية" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <SeekBar android:id="@+id/alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp"/>
        <TextView android:textColor="#FFFFFF" android:text="لون الطبقة" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <GridLayout android:columnCount="3" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/c0" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="60dp"/>
            <Button android:id="@+id/c1" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="60dp"/>
            <Button android:id="@+id/c2" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="60dp"/>
            <Button android:id="@+id/c3" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="60dp"/>
            <Button android:id="@+id/c4" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="60dp"/>
            <Button android:id="@+id/c5" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="60dp"/>
            <Button android:id="@+id/c6" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="60dp"/>
            <Button android:id="@+id/c7" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="60dp"/>
            <Button android:id="@+id/c8" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="60dp"/>
        </GridLayout>
    </LinearLayout>
</ScrollView>
