<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shade Overlay"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:layout_marginBottom="32dp"/>
    <Button android:id="@+id/btn_toggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تشغيل الطبقة"/>
    <Button android:id="@+id/btn_apps" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="التطبيقات المثبة"/>
    <Button android:id="@+id/btn_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اعدادات الشادر واللون"/>
</LinearLayout>
